# ─────────────────────────────────────────────────────────
#  قالب اتصال گوگل شیت
#
#  کاری که باید بکنید:
#    ۱. این فایل را کپی کنید:  cp gsheet.env.example gsheet.env
#    ۲. دو خط زیر را پر کنید
#    ۳. بگویید «پر کردم» — بقیه اش با من
#
#  فایل gsheet.env در gitignore است، پس هرگز آپلود نمی شود.
#  مقادیر را در چت ننویسید؛ فقط داخل فایل بگذارید.
# ─────────────────────────────────────────────────────────

# آدرسی که Apps Script بعد از Deploy می دهد (باید به exec ختم شود)
GSHEET_URL=

# همان رشته ای که در خط ۱۷ فایل AppsScript.gs گذاشتید
GSHEET_TOKEN=
